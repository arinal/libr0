  { "type": "rectangle", "id": "prologue", "x": 480, "y": 92, "width": 320, "height": 96, "backgroundColor": "#fff3bf", "fillStyle": "hachure", "strokeColor": "#e8590c", "strokeWidth": 1, "roughness": 3, "opacity": 100, "roundness": { "type": 3 } },
  { "type": "text", "id": "pro0", "x": 494, "y": 100, "text": "; Function prologue (assembly)", "fontSize": 12, "fontFamily": 3, "strokeColor": "#e8590c", "originalText": "; Function prologue (assembly)", "autoResize": true },
  { "type": "text", "id": "pro1", "x": 494, "y": 122, "text": "push rbp       ; Save old base ptr", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "push rbp       ; Save old base ptr", "autoResize": true },
  { "type": "text", "id": "pro2", "x": 494, "y": 142, "text": "mov rbp, rsp   ; Set new base ptr", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "mov rbp, rsp   ; Set new base ptr", "autoResize": true },
  { "type": "text", "id": "pro3", "x": 494, "y": 162, "text": "sub rsp, 128   ; Allocate locals", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "sub rsp, 128   ; Allocate locals", "autoResize": true },

  { "type": "rectangle", "id": "code", "x": 480, "y": 210, "width": 320, "height": 274, "backgroundColor": "#f8f9fa", "fillStyle": "hachure", "strokeColor": "#1e1e1e", "strokeWidth": 1, "roughness": 3, "opacity": 100, "roundness": { "type": 3 } },
  { "type": "text", "id": "c0", "x": 494, "y": 220, "text": "static GLOBAL_S: &str = \"Global\";", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "static GLOBAL_S: &str = \"Global\";", "autoResize": true },
  { "type": "text", "id": "c1", "x": 494, "y": 240, "text": "static mut GLOBAL_N: u32 = 10;", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "static mut GLOBAL_N: u32 = 10;", "autoResize": true },
  { "type": "text", "id": "c2", "x": 494, "y": 260, "text": "static mut BUFFER = [0; 10_000];", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "static mut BUFFER = [0; 10_000];", "autoResize": true },
  { "type": "text", "id": "c3", "x": 494, "y": 286, "text": "fn main() {", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "fn main() {", "autoResize": true },
  { "type": "text", "id": "c4", "x": 494, "y": 306, "text": "    // function prologue", "fontSize": 12, "fontFamily": 3, "strokeColor": "#868e96", "originalText": "    // function prologue", "autoResize": true },
  { "type": "text", "id": "c5", "x": 494, "y": 326, "text": "    let x = 42;", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let x = 42;", "autoResize": true },
  { "type": "text", "id": "c6", "x": 494, "y": 346, "text": "    let y = 100;", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let y = 100;", "autoResize": true },
  { "type": "text", "id": "c7", "x": 494, "y": 366, "text": "    let s = String::from(\"Local\");", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let s = String::from(\"Local\");", "autoResize": true },
  { "type": "text", "id": "c8", "x": 494, "y": 386, "text": "    let v = vec![1, 2, 3, 4, 5];", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let v = vec![1, 2, 3, 4, 5];", "autoResize": true },
  { "type": "text", "id": "c9", "x": 494, "y": 406, "text": "    let arr = [10, 20, 30, 40, 50];", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let arr = [10, 20, 30, 40, 50];", "autoResize": true },
  { "type": "text", "id": "c10", "x": 494, "y": 426, "text": "    let doubled = process_data(x, &s);", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let doubled = process_data(x, &s);", "autoResize": true },
  { "type": "text", "id": "c11", "x": 494, "y": 446, "text": "    ...", "fontSize": 12, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    ...", "autoResize": true },
