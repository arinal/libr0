  { "type": "text", "id": "c1",  "x": 534, "y": 200, "text": "static GLOBAL_S: &str = \"Global\";", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "static GLOBAL_S: &str = \"Global\";", "autoResize": true },
  { "type": "text", "id": "c2",  "x": 534, "y": 218, "text": "static mut GLOBAL_N: u32 = 10;", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "static mut GLOBAL_N: u32 = 10;", "autoResize": true },
  { "type": "text", "id": "c3",  "x": 534, "y": 236, "text": "static mut BUFFER = [0; 10_000];", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "static mut BUFFER = [0; 10_000];", "autoResize": true },
  { "type": "text", "id": "c4",  "x": 534, "y": 262, "text": "fn main() {", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "fn main() {", "autoResize": true },
  { "type": "text", "id": "c5",  "x": 534, "y": 280, "text": "    let x = 42;", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let x = 42;", "autoResize": true },
  { "type": "text", "id": "c6",  "x": 534, "y": 298, "text": "    let y = 100;", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let y = 100;", "autoResize": true },
  { "type": "text", "id": "c7",  "x": 534, "y": 316, "text": "    let s = String::from(\"Local\");", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let s = String::from(\"Local\");", "autoResize": true },
  { "type": "text", "id": "c8",  "x": 534, "y": 334, "text": "    let v = vec![1, 2, 3, 4, 5];", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let v = vec![1, 2, 3, 4, 5];", "autoResize": true },
  { "type": "text", "id": "c9",  "x": 534, "y": 352, "text": "    let arr = [10, 20, 30, 40, 50];", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let arr = [10, 20, 30, 40, 50];", "autoResize": true },
  { "type": "text", "id": "c10", "x": 534, "y": 370, "text": "    let doubled =", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let doubled =", "autoResize": true },
  { "type": "text", "id": "c11", "x": 534, "y": 388, "text": "        process_data(x, &s);", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "        process_data(x, &s);", "autoResize": true },
  { "type": "text", "id": "c12", "x": 534, "y": 406, "text": "    ...", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    ...", "autoResize": true },
  { "type": "text", "id": "c13", "x": 534, "y": 424, "text": "}", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "}", "autoResize": true },
  { "type": "text", "id": "c14", "x": 534, "y": 450, "text": "fn process_data(", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "fn process_data(", "autoResize": true },
  { "type": "text", "id": "c15", "x": 534, "y": 468, "text": "    param_num: i32,", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    param_num: i32,", "autoResize": true },
  { "type": "text", "id": "c16", "x": 534, "y": 486, "text": "    param_text: &String", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    param_text: &String", "autoResize": true },
  { "type": "text", "id": "c17", "x": 534, "y": 504, "text": ") -> i32 {", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": ") -> i32 {", "autoResize": true },
  { "type": "text", "id": "c18", "x": 534, "y": 522, "text": "    let result = param_num * 2;", "fontSize": 13, "fontFamily": 3, "strokeColor": "#1e1e1e", "originalText": "    let result = param_num * 2;", "autoResize": true },
